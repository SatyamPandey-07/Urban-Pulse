<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Carried over from the original app's manifest. CALL_PHONE is still not
         re-declared: "Call Venue" hands off to the dialer via an intent, which
         does not place a call on the user's behalf. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Emergency SOS sends one SMS per emergency contact. Requested at the
         moment it is needed, never at launch, and refusing it is a supported
         path: the SOS controller then opens the system composer instead and
         reports `prepared` rather than `sent`. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- The Connect IQ SDK reaches the watch over Garmin Connect Mobile's bound
         service; on Android 12+ that needs the new Bluetooth permission. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:label="UrbanPulse"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Garmin Connect Mobile, which hosts the Connect IQ service the SDK binds
         to. Declared so the SDK can see whether it is installed on Android 11+. -->
    <queries>
        <package android:name="com.garmin.android.apps.connectmobile" />
        <!-- Required to query activities that can process text, see:
             https://developer.android.com/training/package-visibility -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: the "Call Venue" action opens the system dialer. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- speech_to_text: voice input on the Yatri AI composer. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- The SOS composer fallback, when SEND_SMS is refused. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
    </queries>
</manifest>
